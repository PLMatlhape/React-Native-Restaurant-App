{
  "expo": {
    "name": "Coffee Shop",
    "slug": "React-Native-Restaurant-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/app-cup-launcher-bold.png",
    "scheme": "coffeeshop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.matlhape.ReactNativeRestaurantApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6F4E37",
        "foregroundImage": "./assets/icon/app-cup-foreground-bold-white.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.matlhape.ReactNativeRestaurantApp"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/app-cup-launcher-bold.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#6F4E37",
          "dark": {
            "backgroundColor": "#6F4E37"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/app-cup-foreground-bold-white.png",
          "color": "#6F4E37"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "069b8468-213f-4190-b384-6e4aecb92c75"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/069b8468-213f-4190-b384-6e4aecb92c75"
    }
  }
}
